# Vercel (server) — set these in Vercel → Project → Settings → Environment Variables. Never commit real keys.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5)
ANTHROPIC_MODEL=
# Only if your key is not scoped to a workspace (error mentions anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# App (native builds only) — the deployed Vercel URL, so the phone app can reach the API.
EXPO_PUBLIC_API_URL=
